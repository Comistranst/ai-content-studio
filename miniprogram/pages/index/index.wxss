.page {
  padding: 40rpx 32rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
  box-sizing: border-box;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #111111;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 56rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
  margin-bottom: 20rpx;
}

.input {
  height: 88rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  border: 1px solid #dddddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.button {
  background-color: #111111;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.result-card {
  margin-top: 40rpx;
  padding: 28rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.result-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #111111;
  margin-bottom: 20rpx;
}

.result-content {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333333;
  white-space: pre-wrap;
}

.copy-button {
  margin-top: 28rpx;
  background-color: #ffffff;
  color: #111111;
  border: 1px solid #111111;
  border-radius: 12rpx;
  font-size: 30rpx;
}