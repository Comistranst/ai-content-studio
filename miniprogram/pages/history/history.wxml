<view class="page">
  <view class="header">
    <text class="title">历史记录</text>
    <text class="subtitle">你生成过的文案都保存在这里</text>
  </view>

  <view wx:if="{{loading}}" class="status">
    <text>正在加载历史记录…</text>
  </view>

  <view wx:elif="{{history.length === 0}}" class="status">
    <text class="empty-title">暂无历史记录</text>
    <text class="empty-text">先去“生成”页面创作一条文案吧。</text>
  </view>

  <view wx:else>
    <view
      wx:for="{{history}}"
      wx:key="id"
      class="history-card"
    >
      <view class="meta-row">
        <text class="platform">{{item.platform}}</text>
        <text class="time">{{item.created_at}}</text>
      </view>

      <text class="topic">主题：{{item.topic}}</text>

      <text class="card-title">{{item.title || "未生成标题"}}</text>

      <text class="content">{{item.content}}</text>

      <button
        class="copy-button"
        data-content="{{item.content}}"
        bindtap="onCopyTap"
      >
        复制文案
      </button>
    </view>
  </view>
</view>